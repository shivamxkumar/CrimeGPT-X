# CrimeGPT Environment Configuration
# Copy to .env and fill in values

# ── App ──────────────────────────────────────────────────────
APP_NAME=CrimeGPT
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-string-in-production

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://crimegpt:crimegpt_pass@db:5432/crimegpt_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI (REQUIRED) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096

# Optional: OpenAI fallback
OPENAI_API_KEY=

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=crimegpt_admin
MINIO_SECRET_KEY=crimegpt_secret_2024

# ── OCR ──────────────────────────────────────────────────────
OCR_ENGINE=easyocr
# OCR_LANGUAGES=en,hi,gu

# ── Email Notifications ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@your-domain.com
SMTP_PASSWORD=your-smtp-password

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://crimegpt.gujaratpolice.gov.in

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CrimeGPT
