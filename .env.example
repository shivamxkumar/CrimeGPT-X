# CrimeGPT-X Environment Configuration
# Copy to .env and fill in real values. Never commit the real .env file.

# ── App ──────────────────────────────────────────────────────
APP_NAME=CrimeGPT-X
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
PORT=8000
UPLOAD_FOLDER=/tmp/crimegpt-uploads

# ── Database ─────────────────────────────────────────────────
# Local/Docker Compose default shown below. On Railway, use the DATABASE_URL
# provided by the Railway Postgres plugin (prefix it with postgresql+asyncpg://).
# On a free-tier deploy (e.g. Render backend + Neon/Supabase Postgres),
# take the connection string those provide and prefix it the same way —
# they hand you postgresql:// or postgres://, this app needs
# postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://crimegpt:crimegpt_pass@db:5432/crimegpt_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Seeds 5 demo users (password: demo1234) + perf indexes on startup, but
# ONLY if the users table is empty. Safe for local/Docker. On Railway,
# production already has these badge numbers seeded with real unique
# passwords, so this is a no-op there too — but set it to false explicitly
# for defense in depth once real users exist.
SEED_DEMO_DATA=true

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI — Google Gemini (REQUIRED) ─────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
# For higher-quality (slower/costlier) analysis, set: AI_MODEL=gemini-3.1-pro-preview
AI_MAX_TOKENS=4096

# ── ChromaDB (judgments RAG vector store) ─────────────────────
# Set CHROMA_HOST for a real ChromaDB server (Docker Compose default).
# Leave CHROMA_HOST blank on free-tier deploys (e.g. Render) to use an
# embedded on-disk client instead — no separate ChromaDB service needed.
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=./chroma_data

# ── Object Storage (evidence + documents) ─────────────────────
# MinIO for local/Docker (plain HTTP). For Railway/Render, point these at a
# real S3-compatible provider (AWS S3, Cloudflare R2, Backblaze B2) — the
# same `minio` client library works against any S3-compatible endpoint by
# overriding MINIO_ENDPOINT, and MINIO_SECURE=true since those require HTTPS.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=crimegpt_admin
MINIO_SECRET_KEY=crimegpt_secret_2024
MINIO_SECURE=false

# ── OCR ──────────────────────────────────────────────────────
OCR_ENGINE=easyocr
# OCR_LANGUAGES=["en","hi","gu"]

# ── Email Notifications ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
# JSON array of allowed origins (pydantic-settings parses List[str] env vars as JSON)
ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CrimeGPT-X
# Optional one-click "View Demo" login button (frontend/src/app/login/page.tsx).
# Local/staging only — leave unset on the real Railway/Vercel production
# deployment, which uses real accounts with rotated passwords, not demo1234.
NEXT_PUBLIC_DEMO_BADGE=AHM-24-IO-047
NEXT_PUBLIC_DEMO_PASSWORD=demo1234
